{
  "name": "inkwellio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Inkwellio monorepo: Next.js app plus shared workspace packages.",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @inkwellio/web dev",
    "build": "pnpm --filter @inkwellio/web build",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "vitest run",
    "check:boundaries": "depcruise apps/web/src packages --config .dependency-cruiser.cjs",
    "hooks:install": "node tools/install-hooks.mjs",
    "prepare": "node tools/install-hooks.mjs",
    "check": "node tools/gate.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "parse5": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
