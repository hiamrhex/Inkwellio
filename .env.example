# Copy to .env for local development. Never commit .env.
# Validated by apps/web/src/kernel/env.ts at startup.
NODE_ENV=development

# Optional; defaults to "info".
# LOG_LEVEL=info

# Postgres 17. Optional at build time, required as soon as a query runs.
# Local Docker: docker run --name inkwellio-pg -e POSTGRES_PASSWORD=... -p 5432:5432 postgres:17
# Production: the Neon pooled connection string (aws-eu-west-2).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkwellio
